<file path="apps/traefik.yaml">
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: traefik
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://traefik.github.io/charts
    chart: traefik
    targetRevision: "30.0.2"
    helm:
      values: |
        # Preserve real client source IPs
        service:
          spec:
            externalTrafficPolicy: Local
            loadBalancerIP: "10.0.20.24"

        providers:
          kubernetesCRD:
            enabled: true
            allowCrossNamespace: true # FIX 1: Allows referencing kube-system/crowdsec-bouncer
          kubernetesIngress:
            enabled: true

        # FIX 2: Moved inside helm values block
        experimental:
          plugins:
            crowdsec-bouncer:
              moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
              version: "v1.4.1"

        # OPTIONAL: Applies CrowdSec globally to ALL HTTPS routes on the websecure entrypoint
        # ports:
        #   websecure:
        #     middlewares:
        #       - kube-system-crowdsec-bouncer@kubernetescrd

        # Per-request access logs
        logs:
          access:
            enabled: true
            fields:
              headers:
                defaultMode: keep

        updateStrategy:
          type: Recreate
          rollingUpdate: null

        additionalArguments:
          - "--certificatesresolvers.cloudflare.acme.email=rpearsall1982@gmail.com"
          - "--certificatesresolvers.cloudflare.acme.storage=/data/acme.json"
          - "--certificatesresolvers.cloudflare.acme.dnschallenge=true"
          - "--certificatesresolvers.cloudflare.acme.dnschallenge.provider=cloudflare"
          - "--certificatesresolvers.cloudflare.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53"

        envFrom:
          - secretRef:
              name: traefik-cloudflare-dns-token

        persistence:
          enabled: true
          storageClass: ceph-rbd
          size: 1Gi
          path: /data

        deployment:
          initContainers:
            - name: volume-permissions
              image: busybox:1.36
              command:
                - sh
                - -c
                - |
                  touch /data/acme.json
                  chmod 600 /data/acme.json
                  chown -R 65532:65532 /data
              volumeMounts:
                - name: data
                  mountPath: /data
              securityContext:
                runAsNonRoot: false
                runAsUser: 0
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
</file>

