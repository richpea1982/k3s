<file path="apps/kube-prometheus-stack.yaml">
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: kube-prometheus-stack
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://prometheus-community.github.io/helm-charts
    chart: kube-prometheus-stack
    targetRevision: "87.16.1"
    helm:
      skipCrds: true
      values: |
        prometheus:
          prometheusSpec:
            podMetadata:
              labels:
                workload-tier: memory-heavy
            topologySpreadConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: DoNotSchedule
                labelSelector:
                  matchLabels:
                    workload-tier: memory-heavy
            retentionSize: "25GiB"
            walCompression: true
            resources:
              requests: { cpu: 200m, memory: 1536Mi }
              limits: { memory: 3584Mi }
            storageSpec:
              volumeClaimTemplate:
                spec:
                  storageClassName: ceph-rbd
                  accessModes: ["ReadWriteOnce"]
                  resources:
                    requests: { storage: 20Gi }
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            ruleSelectorNilUsesHelmValues: false
            additionalScrapeConfigs:
              - job_name: 'smartctl-exporter'
                static_configs:
                  - targets:
                      - '10.0.10.11:9633'   # pve1
                      - '10.0.10.12:9633'   # pve2
                      - '10.0.10.13:9633'   # pve3
                      - '10.0.10.14:9633'   # pve4
                      - '10.0.10.15:9633'   # NAS
                    labels:
                      env: homelab
            additionalPrometheusRulesMap:
              k3s-node-health:
                groups:
                  - name: k3s-node-health
                    rules:
                      - alert: K3sNodeDown
                        expr: kube_node_status_condition{condition="Ready", status="true"} == 0
                        for: 5m
                        labels:
                          severity: critical
                        annotations:
                          summary: "K3s node {{ $labels.node }} has been NotReady for 5+ minutes"
                          description: "Fires the alert-router on pve1: Terraform replace + Ansible rejoin for this node."
        alertmanager:
          alertmanagerSpec:
            resources:
              requests: { cpu: 50m, memory: 128Mi }
              limits: { memory: 256Mi }
            storage:
              volumeClaimTemplate:
                spec:
                  storageClassName: ceph-rbd
                  accessModes: ["ReadWriteOnce"]
                  resources:
                    requests: { storage: 20Gi }
          config:
            route:
              receiver: "null"
              routes:
                - matchers:
                    - alertname = "K3sNodeDown"
                  receiver: alert-router
                  repeat_interval: 15m
            receivers:
              - name: "null"
              - name: alert-router
                webhook_configs:
                  - url: "http://10.0.10.17:8080/webhook/alertmanager"
                    send_resolved: true
        grafana:
          podLabels:
            workload-tier: memory-heavy
          topologySpreadConstraints:
            - maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: DoNotSchedule
              labelSelector:
                matchLabels:
                  workload-tier: memory-heavy
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { memory: 256Mi }
          persistence:
            enabled: false
          envValueFrom:
            GF_DATABASE_PASSWORD:
              secretKeyRef:
                name: grafana-db-secret
                key: password
          grafana.ini:
            database:
              type: postgres
              host: grafana-postgres.monitoring.svc.cluster.local:5432
              name: grafana
              user: grafana
              ssl_mode: disable
            analytics:
              check_for_updates: false
          strategy:
            type: Recreate
          sidecar:
            dashboards:
              env:
                REQ_HEALTH_PORT: "10801"
            datasources:
              env:
                REQ_HEALTH_PORT: "10802"
        kubeStateMetrics:
          enabled: true
        nodeExporter:
          enabled: true
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
</file>

