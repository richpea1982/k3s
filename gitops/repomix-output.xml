<file path="manifests/external-services/jellyfin-ingress/ingressroute.yaml">
# Internal-only — VPN (WireGuard/Tailscale) access only, same as Photoprism
# and Vaultwarden. "External" here only means the Jellyfin workload itself
# lives outside K3s (the GPU-pinned LXC on pve2) — it is NOT exposed via
# the Cloudflare Tunnel. Real subdomain (needed for DNS-01), no public
# A/CNAME record — resolve via /etc/hosts on admin/client devices pointing
# at a K3s node IP, or port-forward, until Unbound split-horizon DNS lands.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: jellyfin
  namespace: jellyfin
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`jellyfin.pearsalls.fr`)
      kind: Rule
      middlewares:
        - name: jellyfin-admin-only
      services:
        - name: jellyfin-external
          port: 8096
  tls:
    certResolver: cloudflare
</file>

<file path="manifests/external-services/jellyfin-ingress/middleware.yaml">
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: jellyfin-admin-only
  namespace: jellyfin
spec:
  ipAllowList:
    sourceRange:
      # Management VLAN (VLAN10) — same scope as photoprism-admin-only / grafana-admin-only
      - 10.0.0.0/16
      # Tailscale CGNAT range — replace with the WireGuard client subnet once that migration lands
      - 100.64.0.0/10
</file>

<file path="manifests/external-services/jellyfin-ingress/service-endpoints.yaml">
# Jellyfin itself is NOT a K3s workload — it's the privileged LXC on pve2
# (10.0.30.10), pinned there for iGPU passthrough. This is the same
# selector-less-Service + manual-Endpoints pattern already used for scraping
# external VMs with Prometheus — here it's routing, not monitoring, but the
# mechanism is identical: a Service with no selector just needs its
# Endpoints/EndpointSlice object populated manually, and Traefik treats it
# like any other backend.
#
# REQUIRES a new OPNsense rule: VLAN20 (K3s pods, 10.0.20.0/24) -> pve2's
# LXC IP 10.0.30.10:8096, allow. Same shape as the existing VLAN20 ->
# 10.0.10.17:8080 alert-router rule. Nothing routes without this.
apiVersion: v1
kind: Service
metadata:
  name: jellyfin-external
  namespace: jellyfin
spec:
  ports:
    - port: 8096
      targetPort: 8096
---
apiVersion: v1
kind: Endpoints
metadata:
  name: jellyfin-external
  namespace: jellyfin
subsets:
  - addresses:
      - ip: 10.0.30.10
    ports:
      - port: 8096
</file>

