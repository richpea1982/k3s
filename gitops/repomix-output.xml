<file path="manifests/vaultwarden/postgres-backup-cronjob.yaml">
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-backup
  namespace: vaultwarden
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: 2Gi
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: postgres-backup
  namespace: vaultwarden
spec:
  # 00:30 — ahead of Velero's 01:00 daily schedule, so each night's dump
  # is on disk and gets swept into that backup, not left for the next one.
  schedule: "30 0 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        metadata:
          labels:
            # Deliberately NOT "app: vaultwarden" — that label also matches
            # the vaultwarden Service's selector, which would make this
            # pod a valid (wrong) target for real app traffic for however
            # long each run lasts. Dedicated label + dedicated
            # NetworkPolicy rule instead — see networkpolicy.yaml.
            job: postgres-backup
        spec:
          restartPolicy: OnFailure
          containers:
            - name: pg-dump
              image: postgres:16-alpine
              envFrom:
                - secretRef:
                    name: vaultwarden-secrets
              command:
                - sh
                - -c
                - |
                  set -e

                  # pg_dump has no retry logic of its own — unlike
                  # Vaultwarden's app, it tries once and gives up. Give it
                  # the same patience Vaultwarden's initContainer already
                  # uses, to absorb any transient connectivity blip rather
                  # than fail outright on the first attempt.
                  echo "Waiting for postgres to accept connections..."
                  i=0
                  until pg_isready -h postgres -p 5432 -U "${POSTGRES_USER}" >/dev/null 2>&1; do
                    i=$((i+1))
                    if [ "$i" -ge 30 ]; then
                      echo "ERROR: postgres never became ready after 60s"
                      exit 1
                    fi
                    echo "  not yet ($i)..."
                    sleep 2
                  done
                  echo "postgres is ready."

                  STAMP=$(date +%Y%m%d-%H%M%S)
                  RAW="/backup/vaultwarden-${STAMP}.sql"
                  FILE="${RAW}.gz"

                  echo "Dumping to ${RAW}..."
                  # Deliberately NOT piped into gzip directly — in a shell
                  # pipeline, `set -e` only sees the LAST command's exit
                  # code. A failed pg_dump piped into a successful gzip
                  # would report success on an empty/broken backup. Writing
                  # to a plain file first means pg_dump's own exit code is
                  # what set -e actually checks.
                  PGPASSWORD="${POSTGRES_PASSWORD}" pg_dump \
                    -h postgres -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" \
                    -F p > "${RAW}"

                  # Sanity check: a real dump of this vault is tens of KB
                  # at minimum. Catches a "succeeded but suspiciously
                  # empty" dump that an exit-code check alone might miss.
                  SIZE=$(wc -c < "${RAW}")
                  if [ "${SIZE}" -lt 1024 ]; then
                    echo "ERROR: dump is suspiciously small (${SIZE} bytes) — refusing to keep it"
                    rm -f "${RAW}"
                    exit 1
                  fi

                  gzip "${RAW}"
                  echo "Dump complete: $(ls -lh ${FILE})"

                  echo "Pruning dumps older than 7 days..."
                  find /backup -name "vaultwarden-*.sql.gz" -mtime +7 -print -delete
              volumeMounts:
                - name: backup
                  mountPath: /backup
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
                limits:
                  memory: 256Mi
          volumes:
            - name: backup
              persistentVolumeClaim:
                claimName: postgres-backup
</file>

<file path="manifests/vaultwarden/postgres-statefulset.yaml">
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: vaultwarden
spec:
  clusterIP: None
  selector:
    app: postgres
  ports:
    - port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: vaultwarden
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports:
            - containerPort: 5432
          envFrom:
            - secretRef:
                # Provides POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
                # Created manually — see VAULTWARDEN-README.md. Not in Git.
                name: vaultwarden-secrets
          volumeMounts:
            - name: postgres-data
              mountPath: /var/lib/postgresql/data
              subPath: pgdata # avoids "lost+found" clutter issues on some CSI drivers
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "$(POSTGRES_USER)"]
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "$(POSTGRES_USER)"]
            initialDelaySeconds: 15
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 512Mi
  volumeClaimTemplates:
    - metadata:
        name: postgres-data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: ceph-rbd
        resources:
          requests:
            storage: 2Gi

# --- Backup note ---
# Protected by a nightly pg_dump CronJob (postgres-backup-cronjob.yaml),
# NOT by Velero's Kopia fs-backup directly against this volume — Kopia
# backs up files as they sit on disk, not a WAL-consistent snapshot, so a
# live Postgres data directory backed up that way risks a torn,
# non-restorable copy. The pg_dump output itself is what Velero actually
# protects (it's just a file on a different PVC). True block-level Ceph
# CSI snapshotting remains a planned follow-up for faster recovery point,
# not yet built. See VAULTWARDEN-README.md sections 5-6.
</file>

<file path="manifests/vaultwarden/vaultwarden-deploy.yaml">
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vaultwarden-data
  namespace: vaultwarden
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vaultwarden
  namespace: vaultwarden
spec:
  replicas: 1
  strategy:
    type: Recreate # single RWO volume — never run two pods against it during a rollout
  selector:
    matchLabels:
      app: vaultwarden
  template:
    metadata:
      labels:
        app: vaultwarden
    spec:
      initContainers:
        - name: wait-for-postgres
          image: busybox:1.36
          command:
            - sh
            - -c
            - |
              until nc -z -w2 postgres 5432; do
                echo "waiting for postgres..."
                sleep 2
              done
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 32Mi
      containers:
        - name: vaultwarden
          image: vaultwarden/server:1.37.0-alpine
          ports:
            - containerPort: 80
          env:
            - name: DOMAIN
              value: "https://vault.pearsalls.fr"
            - name: SIGNUPS_ALLOWED
              value: "true" # IMPORTANT: set to "false" and re-sync once your account exists — see VAULTWARDEN-README.md step 3
            - name: WEBSOCKET_ENABLED
              value: "true"
          envFrom:
            - secretRef:
                # Provides DATABASE_URL and ADMIN_TOKEN.
                # Created manually — see VAULTWARDEN-README.md. Not in Git.
                name: vaultwarden-secrets
          volumeMounts:
            - name: vaultwarden-data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /alive
              port: 80
            initialDelaySeconds: 10
          livenessProbe:
            httpGet:
              path: /alive
              port: 80
            initialDelaySeconds: 20
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 256Mi
      volumes:
        - name: vaultwarden-data
          persistentVolumeClaim:
            claimName: vaultwarden-data
---
apiVersion: v1
kind: Service
metadata:
  name: vaultwarden
  namespace: vaultwarden
spec:
  selector:
    app: vaultwarden
  ports:
    - port: 80
      targetPort: 80
</file>

