<file path="apps/velero.yaml">
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: velero
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://vmware-tanzu.github.io/helm-charts
    chart: velero
    targetRevision: "12.1.0"
    helm:
      values: |
        # --- Credentials ---
        # The velero-minio-credentials Secret must already exist in the
        # velero namespace BEFORE this Application first syncs (created
        # manually via kubectl — see VELERO-README.md). ArgoCD will
        # create the namespace (CreateNamespace=true below), but it will
        # NOT create this secret — Velero pods will crash-loop until
        # it's present.
        credentials:
          useSecret: true
          existingSecret: velero-minio-credentials

        # --- Backup storage location (MinIO on the NAS) ---
        configuration:
          backupStorageLocation:
            - name: default
              provider: aws
              bucket: k3s-state
              credential:
                name: velero-minio-credentials
                key: cloud
              config:
                region: main
                s3ForcePathStyle: true
                s3Url: http://10.0.10.15:9000
                insecureSkipTLSVerify: true
          # Kopia-based file-system backup — deliberate choice until a
          # Ceph RBD VolumeSnapshotClass exists (see README gotchas).
          uploaderType: kopia
          volumeSnapshotLocation: []
        # --- AWS plugin (S3-compatible — works against MinIO) ---
        initContainers:
          - name: velero-plugin-for-aws
            image: velero/velero-plugin-for-aws:v1.14.2
            volumeMounts:
              - mountPath: /target
                name: plugins

        # --- Node-agent (Kopia) for PV backup, all nodes ---
        deployNodeAgent: true
        nodeAgent:
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi

        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            memory: 256Mi

        # --- Schedule: daily 01:00, 7-day retention ---
        schedules:
          daily-backup:
            schedule: "0 1 * * *"
            template:
              ttl: "168h0m0s"
  destination:
    server: https://kubernetes.default.svc
    namespace: velero
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
</file>

<file path="manifests/argocd-ingress/ingressroute.yaml">
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server
  namespace: argocd
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`argocd.pearsalls.fr`)
      kind: Rule
      middlewares:
        - name: argocd-admin-only
      services:
        # Port 80 — argocd-server is running with server.insecure: true,
        # same as vaultwarden's backend; Traefik terminates TLS.
        - name: argocd-server
          port: 80
  tls:
    certResolver: cloudflare
</file>

<file path="manifests/argocd-ingress/middleware.yaml">
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: argocd-admin-only
  namespace: argocd
spec:
  ipAllowList:
    sourceRange:
      # VLAN10 (management) only — same scope as the "MGMT -> all VLANs"
      # OPNsense rule. Not opened to VLAN20/30 at all: nothing in the
      # cluster itself needs to reach the ArgoCD UI, only you do.
      - 10.0.0.0/16
      # Tailscale CGNAT range — remove once WireGuard migration lands and
      # replace with whatever subnet the WireGuard client pool ends up on.
      - 100.64.0.0/10
      - 10.42.0.0/16
</file>

<file path="manifests/argocd-ingress/networkpolicy.yaml">
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: argocd-server-ingress
  namespace: argocd
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: argocd-server
  policyTypes:
    - Ingress
  ingress:
    # Only Traefik itself may reach argocd-server — same pattern as the
    # portfolio namespace's isolation policy.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: 8080
    # Kubelet health probes arrive from the node subnet, not a pod.
    - from:
        - ipBlock:
            cidr: 10.0.20.0/24
      ports:
        - protocol: TCP
          port: 8080   # argocd-server's own readiness/liveness probe port
</file>

